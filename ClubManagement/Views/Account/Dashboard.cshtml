@{
    ViewData["Title"] = "Bảng điều khiển quản trị";
}
<section class="admin-page-heading">
    <div><div class="admin-eyebrow"><span></span> KHÔNG GIAN LÀM VIỆC</div><h1>Bảng điều khiển<span>.</span></h1><p>Theo dõi nhịp hoạt động của CLB và quản lý mọi thứ từ một nơi.</p></div>
    <div class="admin-heading-badge"><img class="club-logo club-logo-admin" src="~/images/logo.jpg" asp-append-version="true" alt="Logo CLB Văn nghệ" width="44" height="44" /><div><strong>CLB Văn Nghệ</strong><small>KHU VỰC QUẢN TRỊ</small></div></div>
</section>
<section class="admin-metrics" aria-label="Tổng quan dữ liệu">
    <article class="admin-metric metric-plum"><div class="metric-top"><span>01 / CỘNG ĐỒNG</span><span class="metric-glyph">♧</span></div><strong>@ViewBag.TotalMembers</strong><h2>Thành viên</h2><p>Những người tạo nên câu lạc bộ</p></article>
    <article class="admin-metric metric-orange"><div class="metric-top"><span>02 / LỊCH TRÌNH</span><span class="metric-glyph">✳</span></div><strong>@ViewBag.TotalActivities</strong><h2>Hoạt động</h2><p>Chương trình và buổi sinh hoạt</p></article>
    <article class="admin-metric metric-lilac"><div class="metric-top"><span>03 / TỔ CHỨC</span><span class="metric-glyph">↗</span></div><strong>@ViewBag.TotalClubs</strong><h2>Câu lạc bộ</h2><p>Không gian sáng tạo đang quản lý</p></article>
</section>
<section class="admin-workspace">
    <div class="workspace-heading"><div><span class="section-kicker">ĐIỀU HÀNH CÂU LẠC BỘ</span><h2>Bạn muốn làm gì hôm nay?</h2></div><span class="workspace-label">CHỌN MỘT CHỨC NĂNG <b>↓</b></span></div>
    <div class="admin-action-grid">
        <a asp-controller="Members" asp-action="Index" class="admin-action-card"><span class="action-number">01</span><span class="action-icon">♧</span><strong>Quản lý thành viên</strong><small>Xem và cập nhật hồ sơ</small><span class="action-arrow">↗</span></a>
        <a asp-controller="ClubActivities" asp-action="Index" class="admin-action-card"><span class="action-number">02</span><span class="action-icon">✳</span><strong>Quản lý hoạt động</strong><small>Tạo và điều phối chương trình</small><span class="action-arrow">↗</span></a>
        <a asp-controller="Attendance" asp-action="Index" class="admin-action-card"><span class="action-number">03</span><span class="action-icon">✓</span><strong>Quản lý điểm danh</strong><small>Kiểm tra và duyệt yêu cầu</small><span class="action-arrow">↗</span></a>
        <a asp-controller="MemberRegistration" asp-action="AdminList" class="admin-action-card"><span class="action-number">04</span><span class="action-icon">＋</span><strong>Đơn đăng ký thành viên</strong><small>Xem các yêu cầu tham gia</small><span class="action-arrow">↗</span></a>
        <a asp-controller="ActivityRegistration" asp-action="Index" class="admin-action-card"><span class="action-number">05</span><span class="action-icon">↗</span><strong>Đăng ký hoạt động</strong><small>Danh sách người tham gia</small><span class="action-arrow">↗</span></a>
        <a asp-controller="Contact" asp-action="AdminList" class="admin-action-card"><span class="action-number">06</span><span class="action-icon">✉</span><strong>Tin nhắn liên hệ</strong><small>Phản hồi thành viên</small><span class="action-arrow">↗</span></a>
    </div>
    <div class="admin-logout-row"><span>Hoàn tất công việc? Hãy đăng xuất để bảo vệ tài khoản.</span><a asp-controller="Account" asp-action="Logout" class="btn btn-logout">Đăng xuất <span>↗</span></a></div>
</section>
